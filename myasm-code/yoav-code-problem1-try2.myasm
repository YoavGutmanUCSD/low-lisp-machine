// start

// note: units must be in steps of 2
// r6 is i
// r7 is j
// r4 is max hamming distance
// r5 is min hamming distance

// r0, r1, r2, r3 for playing around with

// problem1 
sim 0
mov r1
mov r4
sim 2
mov r2
sim 16
mov r5

// outer
// (= i 62)
sim 1 
mov r3
sim 62
not r0
add r3
add r1 
jz 2	// 
j  9	// go to hamming arg setup
// return max and min
sim 0 
add r4
mov r1
sim 0 
add r5
mov r2
// branch to end
sim 19 // TODO: FILL WITH JUMP
lj r0

// hamming arg setup
load r6
mov r1
load r7
mov r2

// hamming
sim 0 
add r2
xor r1
mov r1
j 15 

// set max and min according to count 1s result
mov r1
sim 1
mov r2

// (> distance max)
sim 0
add r4 
not r0
add r2
lsh r0
jc     // TODO: BRANCH
// (< distance min)
// call outer again
sim 0
add r4 
not r0
add r2
lsh r0
jc      // TODO: BRANCH

// count 1s setup
sim 1
mov r2
sim 0
mov r3

// count 1s
lsh r1
jz 5 // back to outer
jc 2
j -3
add r2
j -5

// end  
// outer return 
// 19

