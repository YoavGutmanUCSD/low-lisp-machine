// START

    // R0 is the accumulator 
    
    // R1 holds first number's MSB or LSB
    // R2 holds second number's MSB or LSB
    
    // R3 holds current maximum dist 
    // R4 holds current minimum dist 
    
    // R5 holds current differing bit count (hamming dist) from secondary loops
    
    // R6 holds the xor result of whatever we're XORing 
    
    // R7 holds the main loop max
    // R8 holds location in main loop, its i (WE GO FORWARDS FOR THIS LOOP i++)
    
    // R9 holds secondary loop max - not really necessary
    // R10 holds location in secondary loop (WE GO BACKWARDS FOR THIS LOOP i--)
    
    // R11 for any values we deem necessary 
    // R12 holds memory location 64
    // R13 holds memory location 65
    
    
    
    // Initializing values that don't take a 0
    SIM 16 // 16 into accumulator for initializing the minimum distance
    MOV R4 // Min dist starts at 16.
    
    SIM 63 // for initializing the maximum value for our location in the main loop
    MOV R7 // it's 63 since we're going through those 64 slots of memory
    
    SIM 8 // for initializing the maximum value for our location in the secondary loop
    MOV R9 // it's 8 since we're going through 8 bit numbers
    MOV R10 // secondary loop location starts at 8 since we go backwards for this one
    
    SIM 64 // R12 has memory location 64
    MOV R12
    
    SIM 65 // R13 has memory location 65 
    MOV R13
    
    // Initalizing values that take 0s  
    SIM 0  // stores 0 into accumulator, which we use to initialize multiple values
    MOV R3 // max dist starts at 0 
    MOV R5 // differing bit count starts at 0 
    MOV R6 // xor result starts at 0 
    MOV R8 // main loop location (i) starts at 0 
    
    
    
    // LINE 12 OF REAL CODE RIGHT AFTER THIS LINE  
    // THIS IS THE MAIN LOOP 
    // first thing we do in the loop is get the MSB of the two numbers
    
    // R2 gets the MSB of second number 
    SIM 2    // so we can add 2 to R8 (increment memory address by 2)
    ADD R8   // increment the mem address by 2 (i+2) in R0
    MOV R11  // i+2 now in R11 
    LOAD R11 // get the MSB of the second number into R0 from address in R11 (i+2)
    MOV R2   // R2 now holds the MSB (moved from R0 to R2)
    
    // R1 gets the MSB of first number
    LOAD R8 // get the MSB of the first number into R0 from address in R8
    MOV R1  // R1 now holds the MSB (moved from R0 to R1)
    
    // XOR the MSBs of the first and second numbers now 
    // R0 and R1 contain the first number's MSB, R2 has the second number's MSB
    EOR R2 // XOR R0 and R2 
    MOV R6 // Store XOR result in R6 
    
    // now we count how many bits are different (the amount of 1s in the XOR result)
    SIM 0  // our differing bits starts at 0
    MOV R5 // updating differing bit count
    SIM 8  // position in secondary loop starts at 8, ends at 0
    MOV R9 // R9 now has our current location in the secondary loop
    
    // SECONDARY LOOP ENTRY HERE, LINE 23!!! WE GO BACKWARDS i-- HERE
    LSH R6 // we left shift R6 (xor result), which moves a 1 or a 0 to the carry flag 
    
    // if carry was set, we want to increment the diff bitcount, continue otherwise
    SIM 4    // amount to jump for JC is _ since that's the amount of instructions we skip
    MOV R11  // now holds the amount we want to jump for JC
    JC R11   // going to incrementing loop section
    
    SIM 4    // amount to jump for J is _ since that's the amount of instructions we skip
    MOV R11  // now holds the amount we want to jump for regular J
    J R11    // going to continuing loop section
    
    // incrementing diff bitcount
    SIM 1
    ADD R5 // differing bit count now goes up by 1 
    MOV R5 // storing result in R5 
    
    // continuing 
    SIM -1  // or should i do the twos complement stuff here .. loop counter decrement by 1
    ADD R9  // we go down in the loop, R0 has new location 
    MOV R9  // storing our new location in R9 as well (updated loop counter)
    
    SIM -14 // now, we might wanna go 14 lines back to the start of the loop 
    MOV R11 // store the amount of lines we want to go back in R11 for the jump
    JNZ R11 // if not yet 0 (add R9 would have set it), repeat the loop
    
    
    // same process for LSBs, we get both LSBs
    // not done right now since we're not at the coding part yet anyway
    // but since it follows a similar process, it can be added quickly 
    
    // AT this point R5 contains the number of 1s in the xor result
    // now we update the minimum and maximum 
    // R3 holds current maximum dist 
    // R4 holds current minimum dist 
    // NOT DONE NOT DONE NOT DONE TODODODODOTODO
    
    // want to check if we finished the loop NOT DONE NOT DONE 
    SIM 0 
    ADD R7 // R0 now holds the maximum location for the main loop 
    
    // now we move forward in the main loop NOT DOEN NOT DONE
    SIM 4  // we move 4 number halves at a time in this loop (i+4) so:
    ADD R8 // we add current main location + 4 into R0 to get the new location
    MOV R8 // then update our current location (i) register
    
    JZ - // somewhere around the end we jump back to line 14 if R7 - R8 != 0
    
    
    
    
    // AFTER LOOP ENDS 
    SIM 0
    ADD R4             // Get min dist into R0 
    STR R12            // we store it at memory location 64
    
    SIM 0
    ADD R3             // Get max dist into R0
    STR R13            // we store it at memory location 65
