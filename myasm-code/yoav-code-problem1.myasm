// start

// note: units must be in steps of 2
// r6 is i
// r7 is j
// r4 is pointer to value 1 of pair
// r5 is pointer to value 2 of pair
// r3 is hamming_dist(r4, r5)
// r0, r1, r2 for playing around with

// 1. initialize values 
// init i, &first_pair_value, and dummy distance
sim 0 		// 1
mov r6		// 2
mov r4		// 3
mov r3		// 4
// init j and &second_pair_value
sim 2		// 5
mov r7		// 6
mov r5		// 7
// 2. outer loop
// -43
load r6 	// 8
mov r1		// 9
load r7		// 10
xor r1		// 11
mov r1		// 12
sim 1		// 13
mov r2		// 14
// 3. calculate hamming distance, move to r2
lsh r1		// 15
jc 3		// 16
jz 5		// 17
j -3		// 18
add r2		// 19
jz 2		// 20
j -6		// 21
// hamming distance should now be in r0
mov r2		// 22
// 4. if hamming distance is greater than the current max, replace the values in r3-r5
sim 1 		// 23
mov r1		// 24
// move r3 to r0
sim 0 		// 25
add r3		// 26
// invert
not r0		// 27
add r1		// 28
// get difference (r2 - r3)
add r2		// 29
// if r3 is bigger, the difference is surely negative, meaning 1 lsh will set the carry flag
lsh r0		// 30
jc 2		// 31
j 10		// 32
// replace values
sim 0		// 33
add r2		// 34
mov r3		// 35
sim 0		// 36
add r6		// 37
mov r4 		// 38
sim 0 		// 39
add r7		// 40
mov r5		// 41
// end
// 5. if j > 64, increment i by 2 and set j to i + 2. otherwise, increment j by 2.
//    when incrementing i, check if that would make i == 62
//    note: i have decided to add 'lj', a long relative jump using a value at a register
sim -64		// 42
add r7		// 43
lsh r0		// 44
jc 2		// 45
j 4			// 46
// increment j and go back
sim 2 		// 47
add r7		// 48
mov r7		// 49
sim -43		// 50
lj r0		// 51
// check if i == 60 before incrementing anything
sim -60		// 52
add r6		// 53
jz 15 // PROGRAM END
// increment i and set j to i + 2
sim 2		// 54
add r6		// 55
mov r6		// 56
sim 2		// 57
add r6		// 58
mov r7		// 59
sim -54		// 60
lj r0		// 63
// 6. recur until i == 62
// PROGRAM END
